{
  "name": "rdp-keep-alive",
  "version": "1.0.0",
  "description": "Simple wake lock app to prevent RDP sessions from timing out",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.wake.rdp-keep-alive",
    "productName": "wake",
    "files": ["main.js", "index.html"],
    "win": {
      "target": "portable"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "devDependencies": {
    "electron": "^33.0.1",
    "electron-builder": "^26.15.2"
  }
}
