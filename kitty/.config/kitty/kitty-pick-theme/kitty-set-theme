#!/usr/bin/env bash
# Set the kitty theme for the active (or given) macOS appearance slot.
# Writes <slot>-theme.auto.conf in the kitty config dir, which kitty
# (>= 0.38) applies automatically on top of kitty.conf based on the
# system appearance. kitty.conf itself is never touched.
# Usage: kitty-set-theme "Dracula"
#        kitty-set-theme --light "Bluloco Light"
#        kitty-set-theme --dark  "Catppuccin-Mocha"
#        kitty-set-theme --reset            # remove overlays, back to kitty.conf
#        kitty-set-theme /path/to/theme.conf

set -euo pipefail

config_dir="${KITTY_CONFIG_DIRECTORY:-$HOME/.config/kitty}"
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/kitty-pick-theme"
index="$cache_dir/index.tsv"
themes_user="$config_dir/themes"

reload_kitty() {
  # If kitty exposes an explicit remote-control socket, use it to reload the
  # attached instance. Without KITTY_LISTEN_ON, `kitten @` talks through the
  # terminal and remote-control errors leak visibly into the prompt.
  if [[ -n "${KITTY_LISTEN_ON:-}" ]] && command -v kitten >/dev/null 2>&1; then
    kitten @ --to "$KITTY_LISTEN_ON" load-config --no-response >/dev/null 2>&1 || true
  fi

  # SIGUSR1 makes kitty reload its config, including the .auto.conf overlays.
  # pgrep/pkill can't see the app-bundle kitty process on macOS (hardened
  # runtime), so find PIDs via ps. Matches ".../MacOS/kitty" and bare
  # "kitty", not the kitten child processes.
  local pids
  pids=$(ps ax -o pid=,comm= | awk '$2 ~ /(^|\/)kitty$/ { print $1 }')
  # shellcheck disable=SC2086
  [ -n "$pids" ] && kill -USR1 $pids 2>/dev/null || true

  # On macOS, pressing Ctrl+Cmd+, is kitty's native reload-config shortcut.
  # This is gated to kitty-launched shells so a manual run from another app
  # does not send the shortcut to whichever application happens to be focused.
  if [[ "$(uname -s)" == "Darwin" && -n "${KITTY_WINDOW_ID:-}" ]] && command -v osascript >/dev/null 2>&1; then
    osascript -e 'tell application "System Events" to keystroke "," using {control down, command down}' >/dev/null 2>&1 || true
  fi
}

slot=""
case "${1:-}" in
  --light) slot="light"; shift ;;
  --dark)  slot="dark";  shift ;;
  --reset)
    rm -f "$config_dir/light-theme.auto.conf" \
          "$config_dir/dark-theme.auto.conf" \
          "$config_dir/no-preference-theme.auto.conf"
    reload_kitty
    echo "kitty theme overlays removed -> kitty.conf colors"
    echo "note: running kitty windows keep their colors until kitty is restarted"
    exit 0
    ;;
esac

theme="${1:-}"
if [[ -z "$theme" ]]; then
  echo "usage: kitty-set-theme [--light|--dark|--reset] <theme-name-or-file>" >&2
  exit 64
fi

if [[ -z "$slot" ]]; then
  appearance=$(defaults read -g AppleInterfaceStyle 2>/dev/null || echo "Light")
  if [[ "$appearance" == "Dark" ]]; then slot="dark"; else slot="light"; fi
fi

# Resolve the theme to file contents: direct path, user themes dir,
# the picker's index, then kitten's own resolver as a fallback.
resolve_file() {
  local name="$1"
  if [[ -f "$name" ]]; then echo "$name"; return; fi
  if [[ -f "$themes_user/$name.conf" ]]; then echo "$themes_user/$name.conf"; return; fi
  if [[ -f "$themes_user/$name" ]]; then echo "$themes_user/$name"; return; fi
  if [[ -f "$index" ]]; then
    awk -F'\t' -v n="$name" '$1 == n { print $2; exit }' "$index"
  fi
}

file="$(resolve_file "$theme")"

content=""
if [[ -n "$file" && -f "$file" ]]; then
  content="$(cat "$file")"
else
  content="$(kitten themes --dump-theme "$theme" 2>/dev/null)" || true
  if [[ -z "$content" ]]; then
    echo "theme not found: $theme" >&2
    exit 1
  fi
fi

write_slot() {
  local s="$1" target
  target="$config_dir/${s}-theme.auto.conf"
  {
    echo "# generated by kitty-set-theme — $theme"
    echo "$content"
  } > "$target"
}

# kitty only honors *-theme.auto.conf files that existed when it started:
# created-after-startup files are ignored by config reload, but edits to
# known files apply instantly. Detect the first-ever run so we can tell
# the user a one-time restart is needed.
fresh=0
[[ -f "$config_dir/light-theme.auto.conf" || -f "$config_dir/dark-theme.auto.conf" ]] || fresh=1

write_slot "$slot"

# Mirror ghostty-set-theme: if the other slot has no theme yet, fill it
# with the same one so both appearances are defined.
other=$([[ "$slot" == "light" ]] && echo dark || echo light)
[[ -f "$config_dir/${other}-theme.auto.conf" ]] || write_slot "$other"

reload_kitty

echo "kitty $slot theme -> $theme"
if [[ "$fresh" == 1 ]]; then
  echo "first theme set: restart kitty once (cmd+q) to arm the overlay files —"
  echo "after that, theme changes apply instantly."
fi
