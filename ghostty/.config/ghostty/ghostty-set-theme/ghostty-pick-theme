#!/usr/bin/env bash
# Interactive ghostty theme picker with color-swatch preview.
# Updates the active appearance slot (light or dark) and reloads ghostty.

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
themes_user="$HOME/.config/ghostty/themes"
themes_app="/Applications/Ghostty.app/Contents/Resources/ghostty/themes"

# Renders a preview pane for a single theme: bg/fg + 16-color palette swatches.
preview() {
  local name="$1" file=""
  if [[ -f "$themes_user/$name" ]]; then file="$themes_user/$name"
  elif [[ -f "$themes_app/$name" ]]; then file="$themes_app/$name"
  else echo "theme file not found: $name"; return; fi

  awk -v name="$name" \
      -v lines="${FZF_PREVIEW_LINES:-${LINES:-30}}" \
      -v cols="${FZF_PREVIEW_COLUMNS:-${COLUMNS:-60}}" '
    function strip(s) { sub(/^[[:space:]]+/, "", s); sub(/[[:space:]]+$/, "", s); return s }
    function h2d(s,   i,c,n,v) {
      s = tolower(s); v = 0
      for (i = 1; i <= length(s); i++) {
        c = substr(s,i,1)
        n = index("0123456789abcdef", c) - 1
        if (n < 0) n = 0
        v = v*16 + n
      }
      return v
    }
    function hex(s) {
      gsub(/^#/, "", s)
      return h2d(substr(s,1,2)) ";" h2d(substr(s,3,2)) ";" h2d(substr(s,5,2))
    }
    # Emit one line wrapped in the theme bg, padded out to the preview width.
    # Uses fg as the default text color; \033[K clears-to-eol with current bg.
    function row(content) {
      printf "\033[48;2;%sm\033[38;2;%sm%s\033[K\033[0m\n", hex(bg), hex(fg), content
      emitted++
    }
    /^[[:space:]]*background[[:space:]]*=/ { split($0, a, "="); bg = strip(a[2]) }
    /^[[:space:]]*foreground[[:space:]]*=/ { split($0, a, "="); fg = strip(a[2]) }
    /^[[:space:]]*palette[[:space:]]*=/ {
      split($0, a, "=")
      n = strip(a[2]); col = strip(a[3])
      pal[n+0] = col
    }
    END {
      if (bg == "") bg = "#000000"
      if (fg == "") fg = "#ffffff"
      emitted = 0
      row("")
      row("  \033[1m" name "\033[22m")
      row("  bg " bg "   fg " fg)
      row("")
      row("  Sample text in this theme")
      row("  The quick brown fox jumps over the lazy dog.")
      row("  1234567890  !@#$%^&*()  => || && ::")
      row("")
      # palette swatches drawn directly on the bg
      sw = "      "
      line0 = "  "
      for (i = 0; i < 8; i++) {
        c = pal[i]; if (c == "") c = bg
        line0 = line0 "\033[48;2;" hex(c) "m" sw "\033[48;2;" hex(bg) "m"
      }
      line1 = "  "
      for (i = 8; i < 16; i++) {
        c = pal[i]; if (c == "") c = bg
        line1 = line1 "\033[48;2;" hex(c) "m" sw "\033[48;2;" hex(bg) "m"
      }
      row("  palette:")
      row(line0)
      row(line1)
      # fill remaining height with empty bg-colored rows
      while (emitted < lines) row("")
    }
  ' "$file"
}

if [[ "${1:-}" == "--preview" ]]; then
  preview "$2"
  exit 0
fi

slot_arg=()
case "${1:-}" in
  --light) slot_arg=(--light); ;;
  --dark)  slot_arg=(--dark);  ;;
esac

selected=$(ghostty +list-themes --plain \
  | sed -E 's/ \((user|resources)\)$//' \
  | awk '!seen[$0]++' \
  | fzf \
      --prompt="theme> " \
      --height=80% \
      --layout=reverse \
      --border \
      --no-list-border \
      --preview="$0 --preview {}" \
      --preview-window=right,70%,wrap)

[[ -z "$selected" ]] && exit 0

"$script_dir/ghostty-set-theme" ${slot_arg[@]+"${slot_arg[@]}"} "$selected"
