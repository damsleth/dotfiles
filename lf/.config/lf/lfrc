set hidden true

# High-res image previews via the Kitty graphics protocol (Ghostty supports it).
set previewer ~/.config/lf/preview
set cleaner ~/.config/lf/clean

# l / <enter> on a file: text (markdown included) opens in full-screen vim,
# everything else via the macOS default app. Directories still enter
# normally since lf's open builtin handles those itself.
cmd open ${{
    case "$(file -Lb --mime-type -- "$f")" in
        text/* | application/json | application/javascript | application/xml | application/x-shellscript | inode/x-empty)
            "${EDITOR:-nvim}" "$f" ;;
        *)
            open "$f" ;;
    esac
}}

# Move the current selection (or marked files) to the macOS Trash.
cmd trash ${{
    set -- $fx
    /usr/bin/trash "$@"
}}

# Backspace (keycode 127 / 0x7f) -> trash. <backspace2> is the DEL-style
# backspace macOS terminals send; <backspace> covers the ^H variant.
map <backspace2> trash
map <backspace> trash

# Scroll text previews (markdown, code, JSON): ctrl+j/k one line, J/K half
# a pane. lf can't
# scroll a preview itself, so this keeps the file and a line offset in a
# state file the previewer reads, then has lf redraw the preview.
# Arg: a line count, or half / -half for half a pane.
cmd preview-scroll &{{
    state="${TMPDIR:-/tmp}/lf-preview-scroll"
    { read -r p; read -r n; } < "$state" 2>/dev/null
    [ "$p" = "$f" ] || n=0
    # lf_height is the whole terminal; the pane loses the top and bottom rows
    case "$1" in
        half) d=$(( (lf_height - 2) / 2 )) ;;
        -half) d=$(( -(lf_height - 2) / 2 )) ;;
        *) d=$1 ;;
    esac
    n=$((n + d))
    [ "$n" -lt 0 ] && n=0
    printf '%s\n%s\n' "$f" "$n" > "$state"
    # select (not reload) re-runs just the preview; reload re-reads every pane
    lf -remote "send $id select \"$f\""
}}
map <c-j> preview-scroll 1
map <c-k> preview-scroll -1
map J preview-scroll half
map K preview-scroll -half