#!/bin/sh
# lf previewer. Args: $1=file $2=width $3=height $4=x(col) $5=y(row), in cells.
file="$1"
w="$2"
h="$3"
x="$4"
y="$5"

# Text preview scrolling: ctrl+j/k and J/K (preview-scroll in lfrc) store
# the file and a line offset in $state. Once scrolled, the rendered preview
# is kept in $cache so each further scroll only reads it back: lf blanks the
# pane while the previewer runs, so a re-render per keypress would blink.
state="${TMPDIR:-/tmp}/lf-preview-scroll"
cache="$state.out"
{ read -r p; read -r n; } < "$state" 2>/dev/null
[ "$p" = "$file" ] && [ "${n:-0}" -gt 0 ] && scrolled=1

# Print the page at offset n from $cache, clamped so scrolling stops at the
# last page.
page() {
    max=$(( $(wc -l < "$cache") - h ))
    [ "$max" -lt 0 ] && max=0
    if [ "$n" -gt "$max" ]; then
        n=$max
        printf '%s\n%s\n' "$file" "$n" > "$state"
    fi
    tail -n +$((n + 1)) "$cache"
}

# Cache is valid for this file at this width, unless the file changed since.
# ponytail: not keyed on the dawn theme; a light/dark switch mid-scroll keeps
# the old colours until the file is scrolled from the top again.
if [ -n "$scrolled" ] && [ "$cache" -nt "$file" ] &&
    [ "$(cat "$cache.key" 2>/dev/null)" = "$file $w" ]; then
    page
    exit 1
fi

# Filter for text previews: unscrolled output streams so lf can cut big
# files short; scrolled output goes to $cache first.
scroll() {
    [ -n "$scrolled" ] || { cat; return; }
    cat > "$cache"
    printf '%s\n' "$file $w" > "$cache.key"
    page
}

# Markdown/prose: dawn's rendered view. Matched on extension because
# `file` calls markdown text/plain. DAWN_COLS lays it out for the pane and
# keeps dawn from probing the tty lf is reading; sed drops OSC 8 hyperlinks,
# which lf's preview pane can't render. In kitty, DAWN_TEXT_SIZING has dawn
# emit OSC 66 scaled headings; that needs an lf that draws multi-row preview
# lines (the osc66-multicell-preview branch), stock lf shows them as text.
case "$file" in
    *.md | *.markdown | *.txt)
        if command -v dawn >/dev/null 2>&1; then
            e=$(printf '\033')
            sizing=0
            [ "$TERM" = xterm-kitty ] && sizing=1
            # kitty follows the macOS appearance (*-theme.auto.conf); dawn
            # can't query the background here, so follow it too.
            theme=light
            [ "$(defaults read -g AppleInterfaceStyle 2>/dev/null)" = Dark ] && theme=dark
            DAWN_COLS="$w" DAWN_TEXT_SIZING=$sizing dawn -P -t "$theme" -- "$file" < /dev/null |
                sed "s/${e}]8;;[^${e}]*${e}\\\\//g" | scroll
            # Non-zero: don't cache, so a scroll redraw re-runs this.
            exit 1
        fi
        ;;
esac

case "$(file -Lb --mime-type -- "$file")" in
    image/*)
        # kitten icat does absolute placement (WxH@XxY in cells) without moving
        # the cursor or scrolling, so lf's text columns stay intact. Drawn
        # straight to the terminal because lf would mangle protocol bytes on
        # stdout. memory transfer avoids leaving temp files around.
        kitten icat --silent --stdin no --transfer-mode memory \
            --place "${w}x${h}@${x}x${y}" -- "$file" < /dev/null > /dev/tty
        # Non-zero exit tells lf NOT to cache, so the image is redrawn each
        # time you land on it (the cleaner wipes it when you move away).
        exit 1
        ;;
    text/* | application/json | application/javascript | application/xml)
        if command -v bat >/dev/null 2>&1; then
            # --theme=ansi uses the terminal's own palette, so the preview
            # stays readable in both light and dark Ghostty themes (the
            # bundled defaults assume a dark background).
            bat --color=always --style=plain --paging=never \
                --theme=ansi --wrap=character --terminal-width="$w" -- "$file" | scroll
        else
            cat -- "$file" | scroll
        fi
        exit 1
        ;;
    *)
        file -Lb -- "$file"
        ;;
esac
