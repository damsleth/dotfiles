# Public-safe SSH client template.
# Personal hosts, users, IPs, and keys belong in ~/.ssh/config.d/* from the
# private overlay or local machine state.

Include ~/.ssh/config.d/*

Host *
  AddKeysToAgent yes
  HashKnownHosts yes
  ServerAliveInterval 60
  ServerAliveCountMax 3
  IgnoreUnknown UseKeychain
  UseKeychain yes

# Quoting here is load-bearing, and portable quoting is narrower than it looks.
# The path contains a space, and $HOME must expand, but OpenSSH 9.6 (Ubuntu
# 24.04) cannot parse ESCAPED double quotes inside a Match exec argument: it
# splits on the space and dies with "Unsupported Match attribute", which
# terminates the whole config and takes ssh out on that host. Tilde plus an
# inner SINGLE quote parses on 9.6 and 10.3 alike, expands, and simply does not
# match off macOS. Test on a Linux box before touching this line.
Match exec "test -S ~/'Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock'"
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
