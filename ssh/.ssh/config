# ~/.ssh/config — public template.
#
# This repo is PUBLIC: it intentionally contains NO real hosts, IPs, usernames,
# or keys. Put your own machines in ~/.ssh/config.d/ — every file there is
# pulled in by the Include line below and is NOT tracked by this repo. If you
# use the private overlay, those files live there; otherwise just drop your own.

# Personal/per-host config (gitignored / from the private overlay). Parsed at
# this point, so host-specific options here win over the `Host *` block below.
Include ~/.ssh/config.d/*

# Example host — copy into ~/.ssh/config.d/personal and edit:
#
# Host myserver
#   HostName server.example.com
#   User me
#   ServerAliveInterval 30
#   ServerAliveCountMax 3

# 1Password SSH agent — offers your keys from the 1Password app instead of
# files on disk. Comment out if you don't use 1Password; keys then come from
# ssh-agent / ~/.ssh/id_* as usual. (macOS socket path shown.)
Host *
	IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
